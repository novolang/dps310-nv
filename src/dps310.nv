// dps310 — Infineon's DPS310 digital barometric pressure sensor, on its
// I2C or its SPI bus, as devices-nv's `Barometer`, `Thermometer` and
// `Identifiable`.
//
// The facts below are from Infineon's "DPS310 Digital XENSIV Barometric
// Pressure Sensor for Portable Devices" data sheet, V1.2, 2020-10-15
// (document reference IFX-sch1406115644540; its tables and sections are
// named by number).  Where the sheet and the drivers read for this one
// disagree, the site says which was taken.
//
// The register map (Table 15), as this driver uses it:
//
//   0x00  PSR_B2 to 0x02 PSR_B0   pressure, a 24-bit two's complement count
//   0x03  TMP_B2 to 0x05 TMP_B0   temperature, the same
//   0x06  PRS_CFG   PM_RATE (6:4), PM_PRC (3:0)
//   0x07  TMP_CFG   TMP_EXT (7), TMP_RATE (6:4), TMP_PRC (3:0)
//   0x08  MEAS_CFG  COEF_RDY (7), SENSOR_RDY (6), TMP_RDY (5), PRS_RDY (4),
//                   MEAS_CTRL (2:0)
//   0x09  CFG_REG   INT_HL (7), INT_FIFO (6), INT_TMP (5), INT_PRS (4),
//                   T_SHIFT (3), P_SHIFT (2), FIFO_EN (1), SPI_MODE (0)
//   0x0A  INT_STS   INT_FIFO_FULL (2), INT_TMP (1), INT_PRS (0); clears
//                   on read
//   0x0B  FIFO_STS  FIFO_FULL (1), FIFO_EMPTY (0)
//   0x0C  RESET     FIFO_FLUSH (7), SOFT_RST (3:0)
//   0x0D  ID        REV_ID (7:4), PROD_ID (3:0); reads 0x10
//   0x10  COEF to 0x21: 18 bytes of calibration coefficients
//   0x28  COEF_SRCE TMP_COEF_SRCE (7)
//
// The conversion.  The count of each measurement is divided by a scale
// factor that depends on its oversampling (Table 9), 524288, 1572864,
// 3670016, 7864320, 253952, 516096, 1040384 and 2088960 for 1, 2, 4, 8,
// 16, 32, 64 and 128 times.  With the scaled counts Praw_sc and Traw_sc
// and the coefficients c0 to c30 (section 4.9):
//
//   Tcomp = c0 * 0.5 + c1 * Traw_sc                              (°C)
//   Pcomp = c00 + Praw_sc * (c10 + Praw_sc * (c20 + Praw_sc * c30))
//         + Traw_sc * c01 + Traw_sc * Praw_sc * (c11 + Praw_sc * c21)  (Pa)
//
// The driver evaluates both in `Float`, binary64, in the order above.  An
// oversampling above 8 times needs the matching shift bit of CFG_REG
// (P_SHIFT, T_SHIFT), or the count is wrong.
//
// The coefficients (Table 18, section 8.11): c0 and c1 are 12 bits, c00
// and c10 are 20 bits, the others 16, all two's complement, packed
// across bytes.
//
// The two buses.  On I2C the part answers at 0x77, or 0x76 with SDO low,
// and the register address advances after each byte.  On SPI a
// transaction is a control byte, then data, inside one chip-select
// window: bit 7 is R/W (1 reads) and bits 6 to 0 the register; the
// address advances after each byte of a read, and a read carries no dummy
// byte.  The part takes SPI mode 3 up to 10 MHz, and leaves I2C for good
// when CSB first goes low (section 6).  The interrupt shares the SDO pin
// with the address strap on I2C and with the data output on 4-wire SPI,
// so an SPI part of this driver has no interrupt line; the interrupt
// polarity must be the opposite of the strap, active high with SDO low
// (section 4.6).
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/infineon/dps310`, Infineon's Arduino library
// `DPS310-Pressure-Sensor` and the Linux kernel's
// `drivers/iio/pressure/dps310.c`.  Each fix kept is named at its site.
//
// The driver holds no state: the oversampling is read from the part in
// the same transaction as the counts, and the coefficients are read by
// the caller once and passed in.
//
// A bus enters through `Dps310Port`, which a type that holds a bus
// implements: `Dps310` for an I2C bus and `Dps310Spi` for an SPI bus.
// The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over
// a double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_baro.{ Pascals, Barometer }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let PSR_B2    = 0x00
let PRS_CFG   = 0x06
let TMP_CFG   = 0x07
let MEAS_CFG  = 0x08
let CFG_REG   = 0x09
let INT_STS   = 0x0A
let FIFO_STS  = 0x0B
let RESET     = 0x0C
let PRODUCT_ID = 0x0D
let COEF      = 0x10
let COEF_SRCE = 0x28

// Registers that no table of the data sheet lists, which the temperature
// workaround reads and writes (see `temp_workaround`).
let UNDOC_CHECK = 0x32
let UNDOC_KEY_A = 0x0E
let UNDOC_KEY_B = 0x0F
let UNDOC_GAIN  = 0x62

// ID's value for the DPS310: product 0, revision 1.
let ID_DPS310 = 0x10

// The SPI control byte's R/W bit.
let SPI_READ = 0x80

// RESET: the soft-reset command, and the FIFO flush bit.
let RESET_SOFT = 0x09
let RESET_FIFO_FLUSH = 0x80

// MEAS_CFG: the coefficient and sensor ready bits, the two result ready
// bits, and the measurement control field.
let MEAS_COEF_RDY = 0x80
let MEAS_SENSOR_RDY = 0x40
let MEAS_TMP_RDY = 0x20
let MEAS_PRS_RDY = 0x10
let MEAS_CTRL = 0x07
// MEAS_CTRL's values: standby, a pressure and a temperature measurement on
// request, and the background modes.
let CTRL_STANDBY = 0
let CTRL_PRESSURE = 1
let CTRL_TEMPERATURE = 2
let CTRL_BG_PRESSURE = 5
let CTRL_BG_TEMPERATURE = 6
let CTRL_BG_BOTH = 7

// CFG_REG: the interrupt polarity and sources, the result shifts, the FIFO
// enable.
let CFG_INT_HL = 0x80
let CFG_INT_FIFO = 0x40
let CFG_INT_TMP = 0x20
let CFG_INT_PRS = 0x10
let CFG_T_SHIFT = 0x08
let CFG_P_SHIFT = 0x04
let CFG_FIFO_EN = 0x02

// FIFO_STS: the empty flag.
let FIFO_EMPTY = 0x01
// The most results the FIFO holds.
let FIFO_DEPTH = 32

// TMP_CFG's external-sensor bit, and the field widths of PRS_CFG and
// TMP_CFG.
let TMP_EXT = 0x80
let RATE_SHIFT = 4
let RATE_MASK = 0x70
let PRC_MASK = 0x0F

// The counts a result register holds before the first measurement (0) and
// after the FIFO runs dry (0x800000, which reads as -2^23).
let RAW_NONE = 0
let RAW_EMPTY = -8388608

// The oversampling and rate codes `start` sets: 8 times, 4 per second.
let PRC_DEFAULT = 3
let RATE_DEFAULT = 2
// The largest oversampling and rate code (Tables PRS_CFG and TMP_CFG).
let CODE_MAX = 7

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ = 400000
let SPI_HZ = 4000000
let SPI_MODE = 3

// The address strap values: SDO low is 0x76.
let ADDR_SDO_LOW = 0x76

// The most polls of MEAS_CFG that waiting for the start-up or for a
// result makes.
let READY_POLLS = 20000

// One reading, compensated: the temperature in millidegrees Celsius and
// the pressure in millipascals.
pub @value
struct Dps310Sample
    milli_c: Int
    milli_pa: Int

// The coefficients of Table 18 as the signed integers they encode.
pub @value
struct Dps310Cal
    c0: Int
    c1: Int
    c00: Int
    c10: Int
    c01: Int
    c11: Int
    c20: Int
    c21: Int
    c30: Int

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the interrupt pin;
// `irq_mode` answers -1 when the part has no interrupt line on this bus
// and 1 or 0 for the polarity the line must have.
pub trait Dps310Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]
    fn irq_mode(self) -> Int [hw]

// ── The two buses ────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction: the
// control byte with R/W set, then the data, which the part shifts out with
// no dummy byte in between.  Whether it ran, which is whether the wiring
// has a chip select.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                            n: Int, var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((SPI_READ | (reg & 0x7F)) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, R/W clear:
// whether it ran.  The part answers nothing to a write.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x7F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the interrupt pin an input, the bus at 400
// kHz.  Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin
// never drives low before the bus is ready, then an output; the bus at 4
// MHz in mode 3.  Answers whether the wiring has a chip select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's interrupt line on the board, 1 or 0, or -1 for
// a wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// The interrupt polarity an I2C wiring needs: -1 when the board wires no
// interrupt pin, 1 (active high) when the address is 0x76, which is SDO
// pulled low, and 0 (active low) otherwise.  The interrupt is on the SDO
// pin, so it must not pull the strap the other way (section 4.6).
pub fn irq_mode_of(w: DeviceWiring) -> Int
    if w.irq == None
        return -1
    if w.addr == Some(ADDR_SDO_LOW)
        return 1
    0

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Dps310Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  A register with a bit that clears itself or that
// reads back differently is written with `write_reg`.
pub fn reg_write<P: Dps310Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `v`, leaving the
// others: whether the part took it.
pub fn reg_update<P: Dps310Port>(p: P, reg: Int, mask: Int, v: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (v & mask))

// ── Identity ─────────────────────────────────────────────────────────

// ID as a `DeviceId`, with its revision nibble as `rev`, or `None` when no
// part answers: the byte reads 0xFF on an SPI bus no part drives and 0x00
// on one held low.
pub fn id_read<P: Dps310Port>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, PRODUCT_ID) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: Some(who >> 4) })

// ── Conversion ───────────────────────────────────────────────────────

// The scale factor of Table 9 for an oversampling code 0 to 7, which is
// 1, 2, 4, 8, 16, 32, 64 and 128 times.
pub fn scale_of(osr: Int) -> Int
    match osr & CODE_MAX
        0 => 524288
        1 => 1572864
        2 => 3670016
        3 => 7864320
        4 => 253952
        5 => 516096
        6 => 1040384
        _ => 2088960

// The measurement time of Table 16 for an oversampling code, in
// microseconds, and the time the driver answers: that plus 20 %, as the
// table gives typical figures.
pub fn typical_us(osr: Int) -> Int
    match osr & CODE_MAX
        0 => 3600
        1 => 5200
        2 => 8400
        3 => 14800
        4 => 27600
        5 => 53200
        6 => 104400
        _ => 206800

// The conversion time of one measurement, plus 20 %.
pub fn conversion_us(osr: Int) -> Int
    (typical_us(osr) * 6 + 4) / 5

// The signed 24-bit count at `i` of `b`, most significant byte first.
fn s24_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i] as Int << 16) | (b[i + 1] as Int << 8) | b[i + 2] as Int, 24)

// The signed 16-bit value at `i` of `b`, most significant byte first.
fn s16_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i] as Int << 8) | b[i + 1] as Int, 16)

// The coefficients from the 18 bytes at 0x10 (Table 18): c0 is
// byte 0 and the high nibble of byte 1, c1 the low nibble of byte 1 and
// byte 2, c00 bytes 3 and 4 and the high nibble of byte 5, c10 the low
// nibble of byte 5 and bytes 6 and 7, then c01, c11, c20, c21 and c30 as
// two bytes each.
pub fn cal_of(b: DevBytes) -> Dps310Cal
    Dps310Cal {
        c0: dev_bus.dev_sign_extend((b[0] as Int << 4) | (b[1] as Int >> 4), 12),
        c1: dev_bus.dev_sign_extend(((b[1] as Int & 0x0F) << 8) | b[2] as Int, 12),
        c00: dev_bus.dev_sign_extend((b[3] as Int << 12) | (b[4] as Int << 4) | (b[5] as Int >> 4), 20),
        c10: dev_bus.dev_sign_extend(((b[5] as Int & 0x0F) << 16) | (b[6] as Int << 8) | b[7] as Int, 20),
        c01: s16_at(b, 8),
        c11: s16_at(b, 10),
        c20: s16_at(b, 12),
        c21: s16_at(b, 14),
        c30: s16_at(b, 16) }

// The temperature in degrees Celsius for a raw count and the temperature
// oversampling code it was taken at (section 4.9.2).
pub fn temperature_c(cal: Dps310Cal, raw_t: Int, osr_t: Int) -> Float
    let t_sc = (raw_t as Float) / (scale_of(osr_t) as Float)
    (cal.c0 as Float) * 0.5 + (cal.c1 as Float) * t_sc

// The pressure in pascals for a raw pressure count and the oversampling
// code it was taken at, with the raw temperature count and its oversampling
// code (section 4.9.1).
pub fn pressure_pa(cal: Dps310Cal, raw_p: Int, osr_p: Int, raw_t: Int, osr_t: Int) -> Float
    let p_sc = (raw_p as Float) / (scale_of(osr_p) as Float)
    let t_sc = (raw_t as Float) / (scale_of(osr_t) as Float)
    let a = (cal.c00 as Float) + p_sc * ((cal.c10 as Float) + p_sc * ((cal.c20 as Float) + p_sc * (cal.c30 as Float)))
    let b = a + t_sc * (cal.c01 as Float)
    b + t_sc * p_sc * ((cal.c11 as Float) + p_sc * (cal.c21 as Float))

// `x` rounded to the nearest whole number, halves away from zero.
pub fn round_to_int(x: Float) -> Int
    if x < 0.0
        return (x - 0.5) as Int
    (x + 0.5) as Int

// The whole pascals of a pressure in millipascals, to the nearest.
pub fn pa_of_milli_pa(m: Int) -> Int
    if m < 0
        return (m - 500) / 1000
    (m + 500) / 1000

// Whether a count is a result: the registers read 0 before the first
// measurement and 0x800000 when the FIFO has run dry.
pub fn raw_valid(raw: Int) -> Bool
    raw != RAW_NONE and raw != RAW_EMPTY

// The calibration from a part, or `None` when it did not answer.  The
// part has the coefficients ready 40 ms after power-up or a reset.
pub fn cal_read<P: Dps310Port>(p: P) -> ?Dps310Cal [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(COEF, 18, var b)
        return None
    Some(cal_of(b))

// ── Samples ──────────────────────────────────────────────────────────

// The latest results, compensated with `cal`, in one burst of the six
// data registers and the two configuration registers behind them, so the
// oversampling the counts are scaled with is the one they were taken at.
// The part leaves the registers where they are when read.  `None` when the
// part did not answer, or the pressure or the temperature has not been
// measured: the registers read 0 until then.
pub fn measure<P: Dps310Port>(p: P, cal: Dps310Cal) -> ?Dps310Sample [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PSR_B2, 8, var b)
        return None
    let raw_p = s24_at(b, 0)
    let raw_t = s24_at(b, 3)
    let osr_p = b[6] as Int
    let osr_t = b[7] as Int
    if not raw_valid(raw_p) or not raw_valid(raw_t)
        return None
    let t = temperature_c(cal, raw_t, osr_t)
    let pr = pressure_pa(cal, raw_p, osr_p, raw_t, osr_t)
    Some(Dps310Sample { milli_c: round_to_int(t * 1000.0), milli_pa: round_to_int(pr * 1000.0) })

// The latest temperature alone, in millidegrees, compensated with `cal`:
// `None` when the part did not answer or no temperature has been measured.
pub fn measure_temp<P: Dps310Port>(p: P, cal: Dps310Cal) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PSR_B2, 8, var b)
        return None
    let raw_t = s24_at(b, 3)
    if not raw_valid(raw_t)
        return None
    Some(round_to_int(temperature_c(cal, raw_t, b[7] as Int) * 1000.0))

// The latest results, with the calibration read first.  A program that
// reads often reads the calibration once with `cal_read` and calls
// `measure`.
pub fn sample_read<P: Dps310Port>(p: P) -> ?Dps310Sample [hw]
    let Some(cal) = cal_read(p) else return None
    measure(p, cal)

// Whether a new pressure and a new temperature are waiting: MEAS_CFG's
// PRS_RDY and TMP_RDY, which reading the results clears.
pub fn data_ready<P: Dps310Port>(p: P) -> Bool [hw]
    ((reg_read(p, MEAS_CFG) ?? 0) & (MEAS_PRS_RDY | MEAS_TMP_RDY)) == (MEAS_PRS_RDY | MEAS_TMP_RDY)

// Reads INT_STS, which clears it and lowers the interrupt line, and
// answers it, or -1 when the part did not answer.
pub fn irq_clear<P: Dps310Port>(p: P) -> Int [hw]
    reg_read(p, INT_STS) ?? -1

// The latest pressure, rounded to a pascal, with the calibration read
// first; `None` when there is no result.
pub fn baro_read_of<P: Dps310Port>(p: P) -> ?Pascals [hw]
    let Some(s) = sample_read(p) else return None
    Some(Pascals { pa: pa_of_milli_pa(s.milli_pa) })

// The latest temperature in millidegrees, with the calibration read first;
// `None` when there is no result.
pub fn temp_read_of<P: Dps310Port>(p: P) -> ?TempMilliC [hw]
    let Some(cal) = cal_read(p) else return None
    let Some(mc) = measure_temp(p, cal) else return None
    Some(TempMilliC { milli_c: mc })

// ── Modes ────────────────────────────────────────────────────────────

// Writes MEAS_CTRL, the measurement control field, leaving the ready bits
// the part owns, and reads it back: whether the part holds it.  A command
// mode (1 and 2) is not read back, because it ends by itself when the
// measurement does, 3.6 ms after the write at the shortest, and a slow bus
// would read standby.
//
// Fix kept: the Linux driver writes MEAS_CTRL 0 before it writes another
// mode, "MEAS_CFG doesn't update correctly unless first written with 0",
// and `mode_start` does the same.
pub fn meas_write<P: Dps310Port>(p: P, ctrl: Int) -> Bool [hw]
    if not p.write_reg(MEAS_CFG, ctrl)
        return false
    if ctrl == CTRL_PRESSURE or ctrl == CTRL_TEMPERATURE
        return true
    ((reg_read(p, MEAS_CFG) ?? -1) & MEAS_CTRL) == ctrl

// Puts the part in a mode: standby first, then `ctrl`.  Whether the part
// took both.
pub fn mode_start<P: Dps310Port>(p: P, ctrl: Int) -> Bool [hw]
    if not meas_write(p, CTRL_STANDBY)
        return false
    meas_write(p, ctrl)

// Puts the part in standby, in which every register can be configured.
pub fn standby<P: Dps310Port>(p: P) -> Bool [hw]
    meas_write(p, CTRL_STANDBY)

// Starts continuous measurement of pressure and temperature at the rates
// in PRS_CFG and TMP_CFG.
pub fn run_background<P: Dps310Port>(p: P) -> Bool [hw]
    mode_start(p, CTRL_BG_BOTH)

// Starts a pressure measurement and answers the time it takes in
// microseconds, to be waited before the result is read.  A part in
// background mode converts by itself, so nothing is written and the answer
// is 0.  A part in another mode goes through standby first.  -1 when the
// part did not answer or did not take the mode.
pub fn pressure_start<P: Dps310Port>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PRS_CFG, 3, var b)
        return -1
    let mode = (b[2] as Int) & MEAS_CTRL
    if mode == CTRL_BG_PRESSURE or mode == CTRL_BG_BOTH
        return 0
    if not mode_start(p, CTRL_PRESSURE)
        return -1
    conversion_us((b[0] as Int) & PRC_MASK)

// Starts a temperature measurement: the same contract as `pressure_start`,
// with the temperature's oversampling and the background modes that
// measure temperature.
pub fn temperature_start<P: Dps310Port>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(PRS_CFG, 3, var b)
        return -1
    let mode = (b[2] as Int) & MEAS_CTRL
    if mode == CTRL_BG_TEMPERATURE or mode == CTRL_BG_BOTH
        return 0
    if not mode_start(p, CTRL_TEMPERATURE)
        return -1
    conversion_us((b[1] as Int) & PRC_MASK)

// Waits for one of the result flags of MEAS_CFG by polling it, at most
// `READY_POLLS` times: whether it came.
fn wait_flag<P: Dps310Port>(p: P, flag: Int) -> Bool [hw]
    for _i in 0..READY_POLLS
        if ((reg_read(p, MEAS_CFG) ?? 0) & flag) != 0
            return true
    false

// Measures the temperature and then the pressure on request, waiting for
// each by polling its ready flag, and answers the compensated pair.  The
// part ends in standby.  `None` when the part stopped answering or a result
// did not come.
pub fn measure_once<P: Dps310Port>(p: P, cal: Dps310Cal) -> ?Dps310Sample [hw]
    if not mode_start(p, CTRL_TEMPERATURE)
        return None
    if not wait_flag(p, MEAS_TMP_RDY)
        return None
    if not mode_start(p, CTRL_PRESSURE)
        return None
    if not wait_flag(p, MEAS_PRS_RDY)
        return None
    measure(p, cal)

// ── Settings ─────────────────────────────────────────────────────────

// Whether the part is in standby, in which the data sheet lets the
// configuration change.  False when it did not answer.
fn in_standby<P: Dps310Port>(p: P) -> Bool [hw]
    ((reg_read(p, MEAS_CFG) ?? -1) & MEAS_CTRL) == CTRL_STANDBY

// The time one second of measurements at a rate code and an oversampling
// code takes, in microseconds: the rate in measurements a second times
// Table 16's typical time, for the budget check below.
fn budget_us(rate: Int, osr: Int) -> Int
    (1 << rate) * typical_us(osr)

// Whether a pair of rates and oversamplings fits in a second: the rate of
// temperature times its measurement time plus the rate of pressure times
// its own must be under one second (section 4.4).  The rates are codes
// 0 to 7 for 1 to 128 per second.
pub fn rates_fit(pm_rate: Int, osr_p: Int, tmp_rate: Int, osr_t: Int) -> Bool
    budget_us(tmp_rate, osr_t) + budget_us(pm_rate, osr_p) < 1000000

// Sets the oversampling of pressure and temperature, each 0 to 7 for 1 to
// 128 times, and the result shifts of CFG_REG that an oversampling above 8
// times needs: whether the part took it.  The part must be in standby, or
// the call writes nothing and answers `false`; so is a code outside 0 to 7.
//
// Fix kept: Zephyr's, Infineon's and the Linux driver set P_SHIFT and
// T_SHIFT for an oversampling above 8 times and clear them otherwise; a
// count read without its shift is wrong.
pub fn osr_write<P: Dps310Port>(p: P, osr_p: Int, osr_t: Int) -> Bool [hw]
    if osr_p < 0 or osr_p > CODE_MAX or osr_t < 0 or osr_t > CODE_MAX
        return false
    if not in_standby(p)
        return false
    var shifts = 0
    if osr_p > 3
        shifts = shifts | CFG_P_SHIFT
    if osr_t > 3
        shifts = shifts | CFG_T_SHIFT
    if not reg_update(p, PRS_CFG, PRC_MASK, osr_p)
        return false
    if not reg_update(p, TMP_CFG, PRC_MASK, osr_t)
        return false
    reg_update(p, CFG_REG, CFG_P_SHIFT | CFG_T_SHIFT, shifts)

// Sets the background rates of pressure and temperature, each 0 to 7 for 1
// to 128 per second: whether the part took them.  The pair must fit in a
// second with the oversampling the part has (`rates_fit`), the part must be
// in standby, and the codes must be 0 to 7; otherwise nothing is written
// and the answer is `false`.
pub fn rate_write<P: Dps310Port>(p: P, pm_rate: Int, tmp_rate: Int) -> Bool [hw]
    if pm_rate < 0 or pm_rate > CODE_MAX or tmp_rate < 0 or tmp_rate > CODE_MAX
        return false
    if not in_standby(p)
        return false
    var b: DevBytes = Vec.new()
    if not p.read_regs(PRS_CFG, 2, var b)
        return false
    if not rates_fit(pm_rate, (b[0] as Int) & PRC_MASK, tmp_rate, (b[1] as Int) & PRC_MASK)
        return false
    if not reg_update(p, PRS_CFG, RATE_MASK, pm_rate << RATE_SHIFT)
        return false
    reg_update(p, TMP_CFG, RATE_MASK, tmp_rate << RATE_SHIFT)

// ── The FIFO ─────────────────────────────────────────────────────────
//
// The FIFO holds the last 32 results of background mode, pressure and
// temperature mixed, in the order they were taken (section 4.8).  It is
// off after `start`.  It stops recording when it is full and does not
// overwrite, so a program drains it before it fills.  The result registers
// then show the oldest result, and each read of them takes it out.  The
// least significant bit of a word says what it is: 1 for a pressure, 0 for
// a temperature.  The bit stays in the count: the sheet says it does not
// affect the precision, and Infineon's library scales the word as it is.

// Turns the FIFO on: empties it, sets FIFO_EN, and where the board wires
// an interrupt line puts the FIFO-full interrupt on it in place of the
// pressure-ready one.  Whether the part took every setting.  The part must
// be measuring in background mode for results to arrive.
pub fn fifo_start<P: Dps310Port>(p: P) -> Bool [hw]
    if not p.write_reg(RESET, RESET_FIFO_FLUSH)
        return false
    var v = CFG_FIFO_EN
    var mask = CFG_FIFO_EN
    if p.irq_mode() >= 0
        v = v | CFG_INT_FIFO
        mask = mask | CFG_INT_FIFO | CFG_INT_PRS | CFG_INT_TMP
    reg_update(p, CFG_REG, mask, v)

// Turns the FIFO off, empties it, and puts the pressure-ready interrupt
// back where the board wires one: whether the part took every setting.
pub fn fifo_stop<P: Dps310Port>(p: P) -> Bool [hw]
    var v = 0
    var mask = CFG_FIFO_EN
    if p.irq_mode() >= 0
        v = CFG_INT_PRS
        mask = mask | CFG_INT_FIFO | CFG_INT_PRS | CFG_INT_TMP
    if not reg_update(p, CFG_REG, mask, v)
        return false
    p.write_reg(RESET, RESET_FIFO_FLUSH)

// Moves the results of the FIFO into `press` (millipascals) and `temp`
// (millidegrees), each emptied first, oldest first, and answers how many
// words it took out.  A pressure is compensated with the latest
// temperature before it in the batch, or with the first one in the batch
// when it comes first; a pressure in a batch with no temperature is taken
// out and dropped.  At most 32 words are taken.
pub fn fifo_read<P: Dps310Port>(p: P, cal: Dps310Cal, var press: Vec[Int; 32],
                                var temp: Vec[Int; 32]) -> Int [hw]
    press.clear()
    temp.clear()
    var cfg: DevBytes = Vec.new()
    if not p.read_regs(PRS_CFG, 2, var cfg)
        return 0
    let osr_p = (cfg[0] as Int) & PRC_MASK
    let osr_t = (cfg[1] as Int) & PRC_MASK
    var words: Vec[Int; 32] = Vec.new()
    for _i in 0..FIFO_DEPTH
        if ((reg_read(p, FIFO_STS) ?? FIFO_EMPTY) & FIFO_EMPTY) != 0
            break
        var b: DevBytes = Vec.new()
        if not p.read_regs(PSR_B2, 3, var b)
            break
        let _ = words.push(s24_at(b, 0))
    var first_t = RAW_NONE
    var have_t = false
    for w in words
        if (w & 1) == 0 and not have_t
            first_t = w
            have_t = true
    var cur_t = first_t
    for w in words
        if (w & 1) == 0
            cur_t = w
            let _ = temp.push(round_to_int(temperature_c(cal, w, osr_t) * 1000.0))
        elif have_t
            let _ = press.push(round_to_int(pressure_pa(cal, w, osr_p, cur_t, osr_t) * 1000.0))
    words.len()

// ── The temperature workaround ───────────────────────────────────────

// Some parts read about 60 °C when the temperature is about 20 °C.  Infineon
// recommends a write sequence to the undocumented registers 0x0E, 0x0F and
// 0x62 that corrects the sensor's gain, and Zephyr's driver and Infineon's
// library apply it to every part.  The Linux driver reads the undocumented
// register 0x32 first and applies the sequence only when its bit 1 is
// clear; this driver does the same, since a part with the bit set is
// fine.  Whether the part took the writes, or needed none.
pub fn temp_workaround<P: Dps310Port>(p: P) -> Bool [hw]
    let Some(chk) = reg_read(p, UNDOC_CHECK) else return false
    if (chk & 0x02) != 0
        return true
    if not p.write_reg(UNDOC_KEY_A, 0xA5)
        return false
    if not p.write_reg(UNDOC_KEY_B, 0x96)
        return false
    if not p.write_reg(UNDOC_GAIN, 0x02)
        return false
    if not p.write_reg(UNDOC_KEY_A, 0x00)
        return false
    p.write_reg(UNDOC_KEY_B, 0x00)

// ── Bring-up ─────────────────────────────────────────────────────────

// Waits for the start-up that follows a reset: SENSOR_RDY and COEF_RDY
// both set in MEAS_CFG (Table 8 gives 12 ms and 40 ms).  A read that fails
// counts as not ready, since the part may not answer for the first
// milliseconds.  Whether they came within `READY_POLLS` polls.
fn wait_start<P: Dps310Port>(p: P) -> Bool [hw]
    for _i in 0..READY_POLLS
        if ((reg_read(p, MEAS_CFG) ?? 0) & (MEAS_COEF_RDY | MEAS_SENSOR_RDY)) == (MEAS_COEF_RDY | MEAS_SENSOR_RDY)
            return true
    false

// Brings the part up: the bus made ready; ID checked; the part reset
// with the soft-reset command and the start-up waited for; the
// coefficients read once to prove them readable; the temperature sensor
// set to the one the coefficients were made for; 8 times oversampling and
// 4 results a second for both quantities; where the board wires an
// interrupt line, the pressure-ready interrupt on it with the polarity
// that suits the address strap; the temperature workaround; one
// temperature measured on request, which pressure compensation needs; and
// continuous measurement of both.  Answers whether the part answered as a
// DPS310 and took every setting.  The first pressure comes within a
// quarter of a second.
//
// Fix kept: the sheet says the coefficients are made for either the ASIC
// or the MEMS temperature sensor, "highly recommended" to be the same one
// in use, and Zephyr's, Infineon's and the Linux driver all copy
// TMP_COEF_SRCE into TMP_EXT.
pub fn start<P: Dps310Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if reg_read(p, PRODUCT_ID) != Some(ID_DPS310)
        return false
    if not p.write_reg(RESET, RESET_SOFT)
        return false
    if not wait_start(p)
        return false
    if cal_read(p) == None
        return false
    let Some(src) = reg_read(p, COEF_SRCE) else return false
    var ext = 0
    if (src & 0x80) != 0
        ext = TMP_EXT
    if not reg_write(p, TMP_CFG, ext | (RATE_DEFAULT << RATE_SHIFT) | PRC_DEFAULT)
        return false
    if not reg_write(p, PRS_CFG, (RATE_DEFAULT << RATE_SHIFT) | PRC_DEFAULT)
        return false
    var cfg = 0
    let mode = p.irq_mode()
    if mode >= 0
        cfg = CFG_INT_PRS
    if mode == 1
        cfg = cfg | CFG_INT_HL
    if not reg_write(p, CFG_REG, cfg)
        return false
    if not temp_workaround(p)
        return false
    if not mode_start(p, CTRL_TEMPERATURE)
        return false
    if not wait_flag(p, MEAS_TMP_RDY)
        return false
    run_background(p)

// ── The part on an I2C bus ───────────────────────────────────────────

// A DPS310 on a board's I2C bus at the address `w.addr`, 0x77 or 0x76,
// with the board's GPIO for the interrupt line.
pub @value
struct Dps310
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Dps310Port for Dps310
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    fn irq_mode(self) -> Int [hw]
        irq_mode_of(self.w)

impl Dps310
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Dps310
        Dps310 { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The coefficients, to be kept by a program that reads often and
    // passed to `sample_with`.
    fn calibration(self) -> ?Dps310Cal [hw]
        cal_read(self)

    // The latest result compensated with `cal`: the temperature in
    // millidegrees and the pressure in millipascals.
    fn sample_with(self, cal: Dps310Cal) -> ?Dps310Sample [hw]
        measure(self, cal)

    // The latest result, with the coefficients read first.
    fn sample(self) -> ?Dps310Sample [hw]
        sample_read(self)

    // One temperature and one pressure on request, waited for by polling.
    fn sample_once(self, cal: Dps310Cal) -> ?Dps310Sample [hw]
        measure_once(self, cal)

    // Whether a new pressure and a new temperature are waiting.
    fn ready(self) -> Bool [hw]
        data_ready(self)

    // Reads INT_STS, which lowers the interrupt line.
    fn clear_irq(self) -> Int [hw]
        irq_clear(self)

    // Sets the oversampling, 0 to 7 each, in standby.
    fn set_oversampling(self, osr_p: Int, osr_t: Int) -> Bool [hw]
        osr_write(self, osr_p, osr_t)

    // Sets the background rates, 0 to 7 each, in standby.
    fn set_rates(self, pm_rate: Int, tmp_rate: Int) -> Bool [hw]
        rate_write(self, pm_rate, tmp_rate)

    // Standby, and continuous measurement.
    fn sleep(self) -> Bool [hw]
        standby(self)

    fn run(self) -> Bool [hw]
        run_background(self)

    // The FIFO: on, off, and the results out of it.
    fn fifo_begin(self) -> Bool [hw]
        fifo_start(self)

    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    fn fifo_take(self, cal: Dps310Cal, var press: Vec[Int; 32], var temp: Vec[Int; 32]) -> Int [hw]
        fifo_read(self, cal, var press, var temp)

impl Barometer[hw] for Dps310
    // Starts a pressure measurement and answers the time it takes in
    // microseconds, 0 in background mode, -1 when the part did not answer.
    fn baro_start(self) -> Int [hw]
        pressure_start(self)

    // The latest pressure, rounded to a pascal.
    fn baro_read(self) -> ?Pascals [hw]
        baro_read_of(self)

impl Thermometer[hw] for Dps310
    // Starts a temperature measurement, with the same contract.
    fn temp_start(self) -> Int [hw]
        temperature_start(self)

    // The latest temperature in millidegrees.
    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_of(self)

impl Identifiable[hw] for Dps310
    // ID, 0x10, with the revision nibble as `rev`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The part on an SPI bus ───────────────────────────────────────────

// A DPS310 on a board's SPI bus with the chip select `w.cs`, with the
// board's GPIO for the chip select.  The part has no interrupt line on
// 4-wire SPI.
pub @value
struct Dps310Spi
    bus: BoardSpi
    pins: BoardGpio
    w: DeviceWiring

impl Dps310Port for Dps310Spi
    fn setup(self) -> Bool [hw]
        spi_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        spi_read_into(self.bus, self.pins, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        spi_write(self.bus, self.pins, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    // SDO is the data output in 4-wire SPI, so there is no interrupt.
    fn irq_mode(self) -> Int [hw]
        -1

impl Dps310Spi
    // The part on the board's SPI bus with the chip select `w.cs`, as a
    // board's device table builds it.  Nothing is sent.
    fn attach(bus: BoardSpi, pins: BoardGpio, w: DeviceWiring) -> Dps310Spi
        Dps310Spi { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the wiring has no chip select.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The coefficients, to be kept by a program that reads often and
    // passed to `sample_with`.
    fn calibration(self) -> ?Dps310Cal [hw]
        cal_read(self)

    // The latest result compensated with `cal`: the temperature in
    // millidegrees and the pressure in millipascals.
    fn sample_with(self, cal: Dps310Cal) -> ?Dps310Sample [hw]
        measure(self, cal)

    // The latest result, with the coefficients read first.
    fn sample(self) -> ?Dps310Sample [hw]
        sample_read(self)

    // One temperature and one pressure on request, waited for by polling.
    fn sample_once(self, cal: Dps310Cal) -> ?Dps310Sample [hw]
        measure_once(self, cal)

    // Whether a new pressure and a new temperature are waiting.
    fn ready(self) -> Bool [hw]
        data_ready(self)

    // Reads INT_STS.
    fn clear_irq(self) -> Int [hw]
        irq_clear(self)

    // Sets the oversampling, 0 to 7 each, in standby.
    fn set_oversampling(self, osr_p: Int, osr_t: Int) -> Bool [hw]
        osr_write(self, osr_p, osr_t)

    // Sets the background rates, 0 to 7 each, in standby.
    fn set_rates(self, pm_rate: Int, tmp_rate: Int) -> Bool [hw]
        rate_write(self, pm_rate, tmp_rate)

    // Standby, and continuous measurement.
    fn sleep(self) -> Bool [hw]
        standby(self)

    fn run(self) -> Bool [hw]
        run_background(self)

    // The FIFO: on, off, and the results out of it.
    fn fifo_begin(self) -> Bool [hw]
        fifo_start(self)

    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    fn fifo_take(self, cal: Dps310Cal, var press: Vec[Int; 32], var temp: Vec[Int; 32]) -> Int [hw]
        fifo_read(self, cal, var press, var temp)

impl Barometer[hw] for Dps310Spi
    // Starts a pressure measurement and answers the time it takes in
    // microseconds, 0 in background mode, -1 when the part did not answer.
    fn baro_start(self) -> Int [hw]
        pressure_start(self)

    // The latest pressure, rounded to a pascal.
    fn baro_read(self) -> ?Pascals [hw]
        baro_read_of(self)

impl Thermometer[hw] for Dps310Spi
    // Starts a temperature measurement, with the same contract.
    fn temp_start(self) -> Int [hw]
        temperature_start(self)

    // The latest temperature in millidegrees.
    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_of(self)

impl Identifiable[hw] for Dps310Spi
    // ID, 0x10, with the revision nibble as `rev`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)
